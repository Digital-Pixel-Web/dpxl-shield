{
    "name": "digital-pixel/dpxl-shield",
    "description": "DPXL Shield – Security that runs before WordPress does.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Digital Pixel",
            "homepage": "https://digitalpixel.com.br/"
        }
    ],
    "require": {
        "php": ">=7.4",
        "dompdf/dompdf": "^3.1",
        "maxmind-db/reader": "^1.11",
        "paragonie/constant_time_encoding": "^2.0"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "DPXL\\Shield\\": "src/"
        },
        "files": [
            "src/Compat/php-polyfill.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DPXL\\Shield\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4.33"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "check-php74": "php tools/check-php74.php src dpxl-shield.php dpxl-shield-waf.php uninstall.php tests",
        "check": [
            "@check-php74",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "check-php74": "Fails if the source uses syntax above the PHP 7.4 floor.",
        "check": "Runs the PHP 7.4 floor check and the test suite."
    }
}
