<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd" bootstrap="tests/bootstrap.php" colors="true" failOnRisky="true" failOnWarning="true">
  <testsuites>
    <testsuite name="DPXL Shield Unit Tests">
      <directory>tests/Unit</directory>
    </testsuite>
  </testsuites>
  <php>
    <const name="DPXL_SHIELD_TESTS" value="true"/>
  </php>
  <!-- PHPUnit 9 schema: coverage sources are declared with <coverage>, not the
       <source> element introduced in PHPUnit 10. The suite runs on PHPUnit 9 so
       that it can also be executed on PHP 7.4, the version the plugin targets. -->
  <coverage>
    <include>
      <directory suffix=".php">src</directory>
    </include>
    <exclude>
      <directory>src/Admin/Views</directory>
    </exclude>
  </coverage>
</phpunit>
