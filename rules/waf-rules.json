{
    "meta": {
        "version": "2026.07.04",
        "checksum": "",
        "rules_count": 13
    },
    "rules": [
        {
            "id": "generic-001",
            "name": "PHP Code Execution via eval+base64",
            "description": "Detects obfuscated PHP execution attempts using eval() with encoded payloads.",
            "priority": 5,
            "enabled": true,
            "targets": ["GET", "POST", "COOKIE", "BODY"],
            "pattern": "eval\\s*\\(\\s*(?:base64_decode|gzinflate|str_rot13|gzuncompress|rawurldecode|hex2bin)\\s*\\(",
            "pattern_type": "regex",
            "action": "block",
            "log": true,
            "severity": "critical",
            "tags": ["webshell", "rce", "obfuscation"]
        },
        {
            "id": "generic-002",
            "name": "Shell Execution Functions",
            "description": "Detects shell command execution via PHP functions in user input.",
            "priority": 5,
            "enabled": true,
            "targets": ["GET", "POST", "COOKIE", "BODY"],
            "pattern": "\\b(?:system|exec|passthru|shell_exec|popen|proc_open|pcntl_exec)\\s*\\(\\s*(?:\\$_|\\$[a-z])",
            "pattern_type": "regex",
            "action": "block",
            "log": true,
            "severity": "critical",
            "tags": ["rce", "shell"]
        },
        {
            "id": "sqli-001",
            "name": "SQL Injection – GET/POST Parameters",
            "description": "Detects common SQL injection patterns in GET/POST request parameters.",
            "priority": 10,
            "enabled": true,
            "targets": ["GET", "POST"],
            "pattern": "(?:union\\s+(?:all\\s+)?select|select\\s+.+\\s+from|insert\\s+into|drop\\s+(?:table|database)|or\\s+['\"]?1['\"]?\\s*=\\s*['\"]?1|information_schema|load_file\\s*\\(|into\\s+(?:outfile|dumpfile)|benchmark\\s*\\(|sleep\\s*\\(\\s*\\d+)",
            "pattern_type": "regex",
            "action": "block",
            "log": true,
            "severity": "high",
            "tags": ["sqli", "owasp-a03"]
        },
        {
            "id": "sqli-002",
            "name": "SQL Injection – Cookie Values",
            "description": "Detects SQL injection patterns injected via cookies.",
            "priority": 10,
            "enabled": true,
            "targets": ["COOKIE"],
            "pattern": "(?:union\\s+(?:all\\s+)?select|or\\s+1\\s*=\\s*1|drop\\s+table|information_schema)",
            "pattern_type": "regex",
            "action": "block",
            "log": true,
            "severity": "high",
            "tags": ["sqli", "cookie"]
        },
        {
            "id": "rfi-001",
            "name": "Remote File Inclusion",
            "description": "Detects attempts to include remote files via HTTP/FTP URLs in parameters.",
            "priority": 11,
            "enabled": true,
            "targets": ["GET", "POST"],
            "pattern": "(?:https?|ftp):\\/\\/[^\\/]+\\/.*(?:\\.php|\\.php\\?|\\.txt|=)",
            "pattern_type": "regex",
            "action": "block",
            "log": true,
            "severity": "high",
            "tags": ["rfi", "owasp-a05"]
        },
        {
            "id": "lfi-001",
            "name": "Local File Inclusion / Path Traversal",
            "description": "Detects directory traversal and local file inclusion attempts.",
            "priority": 12,
            "enabled": true,
            "targets": ["GET", "POST", "URI"],
            "pattern": "(?:\\.\\.\\/|\\.\\.\\\\/|%2e%2e%2f|%2e%2e\\/|%252e%252e%252f|\\/etc\\/passwd|\\/etc\\/shadow|php:\\/\\/|phar:\\/\\/)",
            "pattern_type": "regex",
            "action": "block",
            "log": true,
            "severity": "high",
            "tags": ["lfi", "path-traversal", "owasp-a01"]
        },
        {
            "id": "xss-001",
            "name": "XSS – Reflected in Parameters",
            "description": "Detects Cross-Site Scripting payloads in GET/POST parameters.",
            "priority": 15,
            "enabled": true,
            "targets": ["GET", "POST"],
            "pattern": "(?:<\\s*script\\b[^>]*>|javascript\\s*:|vbscript\\s*:|\\bon\\w+\\s*=\\s*[\"']?\\s*(?:javascript|\\w+\\s*\\())",
            "pattern_type": "regex",
            "action": "block",
            "log": true,
            "severity": "high",
            "tags": ["xss", "owasp-a03"]
        },
        {
            "id": "xss-002",
            "name": "XSS – HTTP Headers",
            "description": "Detects XSS payloads injected via User-Agent or Referer headers.",
            "priority": 15,
            "enabled": true,
            "targets": ["USER_AGENT", "REFERER"],
            "pattern": "(?:<\\s*script\\b|javascript\\s*:|\\bon\\w+\\s*=)",
            "pattern_type": "regex",
            "action": "block",
            "log": true,
            "severity": "medium",
            "tags": ["xss", "headers"]
        },
        {
            "id": "wp-001",
            "name": "WordPress XML-RPC Abuse",
            "description": "Blocks direct POST requests to xmlrpc.php, a common brute-force vector.",
            "priority": 20,
            "enabled": true,
            "targets": ["URI"],
            "pattern": "xmlrpc\\.php",
            "pattern_type": "regex",
            "action": "block",
            "log": true,
            "severity": "high",
            "tags": ["wordpress", "xmlrpc", "brute-force"]
        },
        {
            "id": "wp-002",
            "name": "WordPress User Enumeration",
            "description": "Blocks ?author=N requests used to enumerate WordPress usernames.",
            "priority": 20,
            "enabled": true,
            "targets": ["GET"],
            "pattern": "\\?author=\\d+",
            "pattern_type": "regex",
            "action": "block",
            "log": true,
            "severity": "medium",
            "tags": ["wordpress", "reconnaissance", "user-enumeration"]
        },
        {
            "id": "wp-003",
            "name": "PHP File Upload",
            "description": "Blocks file upload attempts where the uploaded file has a PHP extension.",
            "priority": 20,
            "enabled": true,
            "targets": ["FILES"],
            "pattern": "\\.(?:php[0-9]?|phtml|phar|php-s|shtml)$",
            "pattern_type": "regex",
            "action": "block",
            "log": true,
            "severity": "critical",
            "tags": ["wordpress", "upload", "webshell"]
        },
        {
            "id": "wp-004",
            "name": "Sensitive File Access",
            "description": "Blocks direct HTTP access to wp-config.php, .env, and other sensitive files.",
            "priority": 20,
            "enabled": true,
            "targets": ["URI"],
            "pattern": "(?:wp-config\\.php|\\.env|\\.htpasswd|\\/\\.git\\/|phpinfo\\.php)",
            "pattern_type": "regex",
            "action": "block",
            "log": true,
            "severity": "high",
            "tags": ["wordpress", "sensitive-files", "information-disclosure"]
        },
        {
            "id": "generic-003",
            "name": "Anomalous HTTP Headers",
            "description": "Detects oversized or binary-injected HTTP headers.",
            "priority": 25,
            "enabled": true,
            "targets": ["USER_AGENT", "REFERER"],
            "pattern": ".{4097,}",
            "pattern_type": "regex",
            "action": "block",
            "log": true,
            "severity": "medium",
            "tags": ["headers", "anomaly"]
        }
    ]
}
